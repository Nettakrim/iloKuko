tokiwait/ 2.5

toki/ [soweli] tomo sin mi li wile e mani la
toki/ [soweli] mi tu o lukin e ijo mani
toki/ [waso] tan pi pilin ni li nasa, taso mi ken

wile/ 1 a mani
# accept only the coin
wile/ 0.125 b kiwen,suno,walo,sike,lawa,sitelen,nanpa,esun

def/ fail
    reject/
    toki/ [soweli] ni li mani ala a!
    toki/ [waso] li wile e mani ala a!
    toki/ [soweli] ilo Kuko li pakala anu seme?
end/

def/ passcoin
    toki/ [waso] a a a ni li mani a!
    toki/ [soweli] mi wile a e ni mute!
end/

def/ passante
    toki/ [waso] ...a pilin sina li lon, ni li pona
    toki/ [soweli] ken la mi o kama jo e ona lon tenpo kama
end/

def/ #item
    test/
        0.5 a test/
            1 b call/ passcoin
            0 b call/ passante
        end/
        0   a call/ fail
    end/
    next/ 5-3
end/

toki/ [kuko] ijo mani