tokiwait/ 2.5

toki/ [soweli] kiwen suno li pona tawa mi
toki/ [soweli] ona li pona tawa lukin
toki/ [waso] lon...

wile/ 1 a kiwen
wile/ 1 b suno
wile/ 1 c kule

def/ fail
    reject/
    test/
        0.5 a toki/ [waso] ni li suno ala
        0.5 b toki/ [waso] ni li kiwen ala
        0 a toki/ [waso] ni li kiwen suno ala a!
    end/
    toki/ [soweli] ...lili la ona li ni
    next/ 5-2
end/

def/ pass
    toki/ [waso] suno a!
    toki/ [soweli] a!
    next/ 5-2
end/

def/ passkule
    toki/ [waso] kule a!
    toki/ [soweli] a!
    next/ 5-2
end/

def/ #item
    tokiwait/ 2.5
    test/
        0.5 a test/
            0.5 b call/ pass
            0.5 c call/ passkule
            0   b call/ fail
        end/
        0   a call/ fail
    end/
end/

